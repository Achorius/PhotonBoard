{
  "name": "photonboard",
  "version": "1.1.2",
  "description": "Professional DMX lighting control application",
  "author": {
    "name": "PhotonBoard",
    "email": "contact@photonboard.app"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux",
    "docs:pdf": "node docs/generate-pdf.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:build": "node scripts/build-fixture-library.mjs",
    "fixtures:update": "node scripts/build-fixture-library.mjs --update",
    "demos:build": "vite-node scripts/build-demos.ts",
    "screenshots": "electron-vite build && xvfb-run -a -s \"-screen 0 1920x1080x24\" node scripts/dev/screenshot.mjs screenshots"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "fast-xml-parser": "^5.5.11",
    "serialport": "^13.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "jspdf": "^4.2.1",
    "playwright": "^1.56.1",
    "postcss": "^8.4.49",
    "puppeteer": "^24.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.0",
    "three": "^0.183.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.4",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.photonboard.app",
    "productName": "PhotonBoard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/fixture-library",
        "to": "fixture-library"
      },
      {
        "from": "resources/demos",
        "to": "demos"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64",
            "armv7l"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64",
            "armv7l"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "synopsis": "DMX lighting console",
      "maintainer": "PhotonBoard <contact@photonboard.app>"
    },
    "dmg": {
      "title": "PhotonBoard",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "deb": {
      "afterInstall": "build/linux-after-install.tpl",
      "depends": [
        "libusb-1.0-0",
        "libasound2t64 | libasound2",
        "libgtk-3-0t64 | libgtk-3-0",
        "zenity"
      ]
    },
    "npmRebuild": false
  },
  "homepage": "https://github.com/Achorius/PhotonBoard",
  "repository": {
    "type": "git",
    "url": "https://github.com/Achorius/PhotonBoard.git"
  }
}
